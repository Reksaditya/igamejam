[gd_scene format=3]

[ext_resource type="Script" path="res://scripts/autoload/study_notes.gd" id="1_notebook"]
[ext_resource type="Script" path="res://scripts/interaction/desktop/study/study_note.gd" id="2_note"]

[sub_resource type="Resource" id="Note_horns"]
script = ExtResource("2_note")
note_id = "dinosaur_triceratops_horns"
assignment_id = "dinosaur_basics"
notebook_text = "Triceratops had three horns: two above the eyes and one above the nose."

[sub_resource type="Resource" id="Note_plates"]
script = ExtResource("2_note")
note_id = "dinosaur_stegosaurus_plates"
assignment_id = "dinosaur_basics"
notebook_text = "Stegosaurus had two rows of large plates along its back."

[sub_resource type="Resource" id="Note_stegosaurus"]
script = ExtResource("2_note")
note_id = "dinosaur_stegosaurus_period"
assignment_id = "dinosaur_basics"
notebook_text = "Stegosaurus lived in the Late Jurassic."

[sub_resource type="Resource" id="Note_tyrannosaurus"]
script = ExtResource("2_note")
note_id = "dinosaur_tyrannosaurus_period"
assignment_id = "dinosaur_basics"
notebook_text = "Tyrannosaurus rex lived in the Late Cretaceous."

[sub_resource type="Resource" id="Note_first"]
script = ExtResource("2_note")
note_id = "dinosaur_first_period"
assignment_id = "dinosaur_basics"
notebook_text = "The earliest known dinosaurs appeared in the Triassic."

[node name="StudyNotes" type="Node"]
script = ExtResource("1_notebook")
entries = Array[ExtResource("2_note")]([SubResource("Note_horns"), SubResource("Note_plates"), SubResource("Note_stegosaurus"), SubResource("Note_tyrannosaurus"), SubResource("Note_first")])
