[gd_scene format=3]

[ext_resource type="Script" path="res://scripts/autoload/study_notes.gd" id="1_notebook"]
[ext_resource type="Script" path="res://scripts/interaction/desktop/study/study_note.gd" id="2_note"]

[sub_resource type="Resource" id="Note_horns"]
script = ExtResource("2_note")
note_id = "dinosaur_triceratops_horns"
assignment_id = "dinosaur_basics"
notebook_text = "Triceratops memiliki tiga tanduk: dua di atas mata dan satu di atas hidung."

[sub_resource type="Resource" id="Note_plates"]
