[sub_resource type="Resource" id="Question_0"]
script = ExtResource("2_question")
prompt = "Sebelum merangkai mesin di lab, apa yang dibutuhkan?"
options = PackedStringArray("Poros tanpa bantalan", "Motor tanpa dudukan", "Blueprint lengkap dan struktur yang selaras", "Pelat dasar tanpa komponen")
correct_option = 2

[sub_resource type="Resource" id="Question_1"]
script = ExtResource("2_question")
prompt = "Bagaimana roda gigi meneruskan putaran?"
options = PackedStringArray("Dengan menutup bantalan", "Melalui gigi yang saling berkaitan", "Dengan melepas dudukan", "Tanpa hubungan mekanis")
correct_option = 1

