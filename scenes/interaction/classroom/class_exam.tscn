[gd_scene format=3]

[ext_resource type="Script" path="res://scripts/interaction/classroom/class_exam.gd" id="1_script"]
[ext_resource type="Theme" path="res://scenes/interaction/desktop/lms/lms_theme.tres" id="2_theme"]

[sub_resource type="StyleBoxFlat" id="StyleBoxFlat_screen"]
bg_color = Color(0.96, 0.96, 0.95, 1)
content_margin_left = 24.0
content_margin_right = 24.0
content_margin_top = 24.0
content_margin_bottom = 24.0

[node name="ClassScreen" type="CanvasLayer"]
process_mode = 3
layer = 20
script = ExtResource("1_script")

[node name="Screen" type="PanelContainer" parent="."]
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
theme = ExtResource("2_theme")
theme_override_styles/panel = SubResource("StyleBoxFlat_screen")

[node name="Scroll" type="ScrollContainer" parent="Screen"]
layout_mode = 2
horizontal_scroll_mode = 0
follow_focus = true

[node name="Content" type="VBoxContainer" parent="Screen/Scroll"]
layout_mode = 2
size_flags_horizontal = 3
theme_override_constants/separation = 14

[node name="HeaderRow" type="HBoxContainer" parent="Screen/Scroll/Content"]
layout_mode = 2
theme_override_constants/separation = 12

[node name="Heading" type="Label" parent="Screen/Scroll/Content/HeaderRow"]
unique_name_in_owner = true
layout_mode = 2
size_flags_horizontal = 3
theme_type_variation = &"LmsHeading"
autowrap_mode = 3

[node name="NotesHint" type="Button" parent="Screen/Scroll/Content/HeaderRow"]
unique_name_in_owner = true
layout_mode = 2
size_flags_vertical = 4
mouse_default_cursor_shape = 2
text = "[Tab] Buka Catatan"
tooltip_text = "Tekan Tab untuk membuka/menutup buku catatan"

[node name="Countdown" type="Label" parent="Screen/Scroll/Content"]
unique_name_in_owner = true
layout_mode = 2
theme_type_variation = &"LmsSubheading"
text = "Sisa waktu 10:00"

[node name="Status" type="Label" parent="Screen/Scroll/Content"]
unique_name_in_owner = true
layout_mode = 2
autowrap_mode = 3

[node name="QuizHost" type="VBoxContainer" parent="Screen/Scroll/Content"]
unique_name_in_owner = true
layout_mode = 2

[node name="Retry" type="Button" parent="Screen/Scroll/Content"]
unique_name_in_owner = true
layout_mode = 2
visible = false
text = "Coba mulai ujian kembali"

[node name="Close" type="Button" parent="Screen/Scroll/Content"]
unique_name_in_owner = true
layout_mode = 2
text = "Kembali ke kelas"
