[sub_resource type="Resource" id="Question_plates"]
script = ExtResource("2_question")
prompt = "Which dinosaur had two rows of large plates on its back?"
options = PackedStringArray("Stegosaurus", "Ankylosaurus", "Iguanodon", "Brachiosaurus")

[sub_resource type="Resource" id="Question_stegosaurus"]
script = ExtResource("2_question")
prompt = "Which period did Stegosaurus live in?"
options = PackedStringArray("Late Triassic", "Early Jurassic", "Early Cretaceous", "Late Jurassic")
correct_option = 3

[sub_resource type="Resource" id="Question_tyrannosaurus"]
script = ExtResource("2_question")
prompt = "Which period did Tyrannosaurus rex live in?"
options = PackedStringArray("Late Jurassic", "Late Cretaceous", "Early Cretaceous", "Late Triassic")
correct_option = 1

[sub_resource type="Resource" id="Question_first_dinosaurs"]
script = ExtResource("2_question")
prompt = "In which period did the earliest known dinosaurs appear?"
options = PackedStringArray("Permian", "Jurassic", "Triassic", "Cretaceous")
correct_option = 2

[sub_resource type="Resource" id="Question_armor"]
script = ExtResource("2_question")
prompt = "Which dinosaur had a club at the end of its tail?"
options = PackedStringArray("Diplodocus", "Ankylosaurus", "Velociraptor", "Allosaurus")
correct_option = 1

[sub_resource type="Resource" id="Question_neck"]
script = ExtResource("2_question")
prompt = "Which dinosaur was a long-necked sauropod?"
options = PackedStringArray("Brachiosaurus", "Triceratops", "Stegosaurus", "Tyrannosaurus")

[sub_resource type="Resource" id="Question_track"]
script = ExtResource("2_question")
prompt = "What can a set of fossil footprints preserve?"
options = PackedStringArray("Feather color", "Blood type", "Direction of travel", "Exact body mass")
correct_option = 2

[sub_resource type="Resource" id="Question_period"]
script = ExtResource("2_question")
prompt = "Which period came after the Jurassic?"
options = PackedStringArray("Permian", "Triassic", "Devonian", "Cretaceous")
correct_option = 3

[sub_resource type="Resource" id="Question_teeth"]
script = ExtResource("2_question")
prompt = "Which feature helps identify a meat-eating dinosaur?"
options = PackedStringArray("Serrated teeth", "Broad grinding teeth", "A leaf-shaped tooth", "A toothless beak alone")

[sub_resource type="Resource" id="Question_horns"]
script = ExtResource("2_question")
prompt = "How many horns did Triceratops have?"
options = PackedStringArray("One", "Two", "Three", "Four")
correct_option = 2

[sub_resource type="Resource" id="dinosaur_kuis_1"]
script = ExtResource("1_assignment")
id = "dinosaur_kuis_1"
title = "Dinosaur basics"
questions = Array[ExtResource("2_question")]([SubResource("Question_plates"), SubResource("Question_stegosaurus"), SubResource("Question_tyrannosaurus"), SubResource("Question_first_dinosaurs"), SubResource("Question_armor"), SubResource("Question_neck"), SubResource("Question_track"), SubResource("Question_period"), SubResource("Question_teeth"), SubResource("Question_horns")])
notebook_assignment_id = "dinosaur_basics"
deadline_day = 7
deadline_hour = 6

[sub_resource type="Resource" id="Question_cast"]
script = ExtResource("2_question")
prompt = "What forms when minerals fill a fossil mold?"
options = PackedStringArray("A cast", "A footprint trail", "A tooth socket", "A growth ring")

[sub_resource type="Resource" id="Question_strata"]
script = ExtResource("2_question")
prompt = "In undisturbed sedimentary layers, where are older layers usually found?"
options = PackedStringArray("Above younger layers", "At the same level", "Below younger layers", "Only at the surface")
correct_option = 2

[sub_resource type="Resource" id="Question_amber"]
script = ExtResource("2_question")
prompt = "What is amber made from?"
options = PackedStringArray("Compacted sand", "Frozen water", "Volcanic ash", "Fossilized tree resin")
correct_option = 3

[sub_resource type="Resource" id="Question_trace"]
script = ExtResource("2_question")
prompt = "Which of these is a trace fossil?"
options = PackedStringArray("A dinosaur trackway", "A thigh bone", "A skull fragment", "An isolated tooth")

[sub_resource type="Resource" id="Question_field"]
script = ExtResource("2_question")
prompt = "What should a fossil collector record before removing a specimen?"
options = PackedStringArray("The naming vote", "Its position and rock layer", "A museum ticket number", "The final display size")
correct_option = 1

[sub_resource type="Resource" id="Question_weathering"]
script = ExtResource("2_question")
prompt = "What can expose fossils embedded in a cliff?"
options = PackedStringArray("Condensation only", "Photosynthesis", "Weathering and erosion", "A change in the tide alone")
correct_option = 2

[sub_resource type="Resource" id="Question_detail"]
script = ExtResource("2_question")
prompt = "What tool helps uncover small bones gently?"
options = PackedStringArray("A large sledgehammer", "A garden hose", "A power drill", "A soft brush")
correct_option = 3

[sub_resource type="Resource" id="Question_context"]
script = ExtResource("2_question")
prompt = "What does rock surrounding a fossil help establish?"
options = PackedStringArray("Its geological context", "Its original eye color", "The name of the animal", "The fossil\'s future owner")

[sub_resource type="Resource" id="Question_comparison"]
script = ExtResource("2_question")
prompt = "What feature can help compare fossil species?"
options = PackedStringArray("The collector\'s initials", "The shape of the bones", "The storage box size", "The label color")
correct_option = 1

[sub_resource type="Resource" id="Question_sediment"]
script = ExtResource("2_question")
prompt = "Which material can bury remains before they fossilize?"
options = PackedStringArray("Sunlight", "Sediment", "Wind alone", "Air alone")
correct_option = 1

