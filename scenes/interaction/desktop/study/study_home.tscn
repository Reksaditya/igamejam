[gd_scene format=3]

[ext_resource type="Theme" path="res://scenes/interaction/desktop/lms/lms_theme.tres" id="1_theme"]
[ext_resource type="Script" path="res://scripts/interaction/desktop/study/study_home.gd" id="2_home"]
[ext_resource type="Script" path="res://scripts/interaction/desktop/study/study_book.gd" id="3_book"]

[sub_resource type="Resource" id="Book_dinosaur"]
script = ExtResource("3_book")
title = "Dasar-Dasar Dinosaurus"
book_id = "dinosaur_field_guide"
reading_text = "Mulailah dengan mengamati tulang-belulangnya. Tiga tanduk menjadi ciri khas Triceratops. Dua baris lempeng besar di sepanjang punggung menjadi ciri khas Stegosaurus.

Satu lapisan batuan sedimen yang terpisah disebut stratum. Dinosaurus paling awal yang diketahui muncul pada periode Trias. Stegosaurus hidup pada periode Jura Akhir, sedangkan Tyrannosaurus rex hidup pada periode Kapur Akhir."
linked_note_ids = PackedStringArray("dinosaur_triceratops_horns", "dinosaur_stegosaurus_plates", "dinosaur_stegosaurus_period", "dinosaur_tyrannosaurus_period", "dinosaur_first_period")

[sub_resource type="Resource" id="Book_core_drive"]
script = ExtResource("3_book")
book_id = "core_drive_primer"
title = "Panduan Penggerak Inti"
cover_color = Color(0.18, 0.42, 0.41, 1)
reading_text = "Mulailah dari roda gigi penggerak motor dan hitung setiap hubungan gigi untuk mengendalikan arah putaran keluaran. Dua lengan pemutar memungkinkan Anda menjembatani pelat secara rapi tanpa penghubung tambahan.

Blueprint lengkapnya tersedia di aplikasi Proyek setelah Anda membuka panduan ini."
reward_type = 1
blueprint_id = "core_drive"

[sub_resource type="Resource" id="Book_sorter"]
script = ExtResource("3_book")
book_id = "sediment_sorter_manual"
title = "Manual Pemilah Sedimen"
cover_color = Color(0.12, 0.31, 0.43, 1)
reading_text = "Pemilah sedimen menyalurkan material melalui saluran masuk dan menggunakan rotor untuk memisahkan butiran berdasarkan ukurannya. Pengukur tekanan memantau kondisi sebelum material mencapai saluran keluar.

Blueprint lengkapnya tersedia di aplikasi Proyek setelah Anda membuka manual ini."
reward_type = 1
blueprint_id = "sediment_sorter"

[sub_resource type="Resource" id="Book_sieve_shaker"]
script = ExtResource("3_book")
book_id = "sieve_shaker_manual"
title = "Manual Pengayak Getar"
cover_color = Color(0.37, 0.34, 0.56, 1)
reading_text = "Pengayak getar menggunakan roda gigi rel geser di antara roda gigi penghubung utama dan poros keluaran. Menggeser roda gigi di sepanjang rel vertikal mengubah jalur sambungan sekaligus membalik arah putaran keluaran.

Blueprint lengkapnya tersedia di aplikasi Proyek setelah Anda membuka manual ini."
reward_type = 1
blueprint_id = "sieve_shaker"

[sub_resource type="Resource" id="Book_core_centrifuge"]
script = ExtResource("3_book")
book_id = "core_centrifuge_manual"
title = "Spesifikasi Sentrifuga Inti"
cover_color = Color(0.49, 0.3, 0.23, 1)
reading_text = "Sentrifuga inti memadukan dua rel geser sejajar dengan tiga roda gigi penghubung tetap dan dua lengan pemutar. Arahkan kedua jalur rel dengan cermat untuk membalik paritas lintasan utama tanpa membuat rangkaian roda gigi macet.

Blueprint lengkapnya tersedia di aplikasi Proyek setelah Anda membuka lembar spesifikasi ini."
reward_type = 1
blueprint_id = "core_centrifuge"

[node name="StudyHome" type="VBoxContainer"]
theme = ExtResource("1_theme")
theme_override_constants/separation = 16
script = ExtResource("2_home")
books = Array[ExtResource("3_book")]([SubResource("Book_dinosaur"), SubResource("Book_core_drive"), SubResource("Book_sorter"), SubResource("Book_sieve_shaker"), SubResource("Book_core_centrifuge")])

[node name="Title" type="Label" parent="."]
unique_name_in_owner = true
layout_mode = 2
theme_type_variation = &"LmsHeading"
text = "Perpustakaan Belajar"
horizontal_alignment = 1

[node name="Books" type="HFlowContainer" parent="."]
unique_name_in_owner = true
layout_mode = 2
theme_override_constants/h_separation = 16
theme_override_constants/v_separation = 16
alignment = 1
last_wrap_alignment = 2

[node name="Status" type="Label" parent="."]
unique_name_in_owner = true
visible = false
layout_mode = 2
theme_type_variation = &"LmsError"
autowrap_mode = 3
horizontal_alignment = 1

[node name="Reading" type="VBoxContainer" parent="."]
unique_name_in_owner = true
visible = false
layout_mode = 2
theme_override_constants/separation = 10

[node name="Toolbar" type="HBoxContainer" parent="Reading"]
layout_mode = 2
theme_override_constants/separation = 12

[node name="Back" type="Button" parent="Reading/Toolbar"]
unique_name_in_owner = true
layout_mode = 2
size_flags_horizontal = 0
text = "Kembali ke daftar buku"

[node name="ReadingStatus" type="Label" parent="Reading/Toolbar"]
unique_name_in_owner = true
layout_mode = 2
size_flags_horizontal = 3
theme_type_variation = &"LmsMeta"
autowrap_mode = 3
horizontal_alignment = 2

[node name="ReadingTitle" type="Label" parent="Reading"]
unique_name_in_owner = true
layout_mode = 2
theme_type_variation = &"LmsHeading"
autowrap_mode = 3
horizontal_alignment = 1

[node name="Passages" type="VBoxContainer" parent="Reading"]
unique_name_in_owner = true
layout_mode = 2
theme_override_constants/separation = 8

[node name="ConfirmStudy" type="ConfirmationDialog" parent="."]
unique_name_in_owner = true
title = "Pelajari buku ini?"
dialog_autowrap = true
dialog_text = "Apakah Anda yakin ingin mempelajari buku ini?"
ok_button_text = "Ya"


[node name="Transition" type="CanvasLayer" parent="."]
layer = 20

[node name="Black" type="ColorRect" parent="Transition"]
unique_name_in_owner = true
visible = false
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
color = Color(0, 0, 0, 0)
