[gd_scene format=3]

[ext_resource type="Script" path="res://scripts/interaction/desktop/file_manager.gd" id="1"]
[ext_resource type="Resource" path="res://scenes/interaction/desktop/folders/files.tres" id="2_files"]

[node name="FileManager" type="MarginContainer"]
theme_override_constants/margin_left = 16
theme_override_constants/margin_top = 14
theme_override_constants/margin_right = 16
theme_override_constants/margin_bottom = 14
script = ExtResource("1")
root_folder = ExtResource("2_files")

[node name="Layout" type="VBoxContainer" parent="."]
layout_mode = 2
theme_override_constants/separation = 12

[node name="Navigation" type="HBoxContainer" parent="Layout"]
layout_mode = 2
theme_override_constants/separation = 8

[node name="Up" type="Button" parent="Layout/Navigation"]
unique_name_in_owner = true
layout_mode = 2
text = "Naik"
tooltip_text = "Buka folder induk"
mouse_default_cursor_shape = 2

[node name="Location" type="Label" parent="Layout/Navigation"]
unique_name_in_owner = true
layout_mode = 2
size_flags_horizontal = 3
theme_type_variation = &"ShellLabel"
text_overrun_behavior = 3

[node name="Scroll" type="ScrollContainer" parent="Layout"]
unique_name_in_owner = true
layout_mode = 2
size_flags_vertical = 3
horizontal_scroll_mode = 0
follow_focus = true

[node name="Pages" type="MarginContainer" parent="Layout/Scroll"]
unique_name_in_owner = true
layout_mode = 2
size_flags_horizontal = 3
